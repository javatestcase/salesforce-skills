#!/usr/bin/env python3
"""Read-only local MCP adapter for documented Salesforce skill calls.

This test-only adapter mirrors Headless 360's ``dispatch_readonly`` signature while allowing
only three explicit read shapes:

* GET GraphQL query endpoint with a read-only GraphQL document;
* GET SOQL query endpoint with a SELECT statement; and
* Configure's GET Opportunity Full/View UI API layout read.

It is intentionally not a general REST proxy. Authentication remains inside the Salesforce CLI.
"""

import html
import json
import os
import re
import subprocess
import sys
import tempfile
import urllib.parse

SERVER_INFO = {"name": "salesforce-readonly", "version": "0.3.0"}
PROTOCOL_VERSIONS = ("2025-11-25", "2025-06-18", "2025-03-26", "2024-11-05")

TOOLS = [
    {
        "name": "dispatch_readonly",
        "title": "Salesforce read (Headless 360-compatible)",
        "description": (
            "Execute an allowlisted read-only Salesforce REST call. Supported: GET "
            "/services/data/vXX.X/graphql with queryParams.queryInput, GET "
            "/services/data/vXX.X/query with queryParams.q containing a SOQL SELECT, and "
            "GET /services/data/v63.0/ui-api/records/<Opportunity Id> with exactly "
            "layoutTypes=Full and modes=View. GraphQL mutations and subscriptions are rejected."
        ),
        "inputSchema": {
            "type": "object",
            "properties": {
                "method": {"type": "string", "enum": ["GET"], "description": "HTTP method; only GET"},
                "url": {"type": "string", "description": "Allowlisted Salesforce GraphQL, SOQL, or Opportunity layout URL"},
                "queryParams": {"type": "object", "description": "Documented parameters for the selected allowlisted read"},
            },
            "required": ["method", "url", "queryParams"],
        },
        "annotations": {"readOnlyHint": True, "destructiveHint": False, "openWorldHint": True},
    },
]
QUERY_URL_RE = re.compile(r"^/services/data/v(\d{2}\.\d)/(graphql|query)$")
LAYOUT_URL_RE = re.compile(r"^/services/data/v63\.0/ui-api/records/(006[0-9A-Za-z]{12}(?:[0-9A-Za-z]{3})?)$")
LAYOUT_PARAMS = {"layoutTypes": "Full", "modes": "View"}


def log(msg):
    print(f"[salesforce-readonly-mcp] {msg}", file=sys.stderr, flush=True)


class ToolError(Exception):
    pass


def graphql_is_read(query):
    stripped = re.sub(r'"(?:[^"\\]|\\.)*"', '""', query)
    stripped = re.sub(r"#[^\n]*", "", stripped)
    if re.search(r"\b(mutation|subscription)\b", stripped):
        return False
    return re.match(r"\s*(query\b|\{|fragment\b)", stripped) is not None


def unescape(obj):
    if isinstance(obj, str):
        return html.unescape(obj)
    if isinstance(obj, list):
        return [unescape(item) for item in obj]
    if isinstance(obj, dict):
        return {key: unescape(value) for key, value in obj.items()}
    return obj


def sf_rest(path, method, body=None):
    """Call Salesforce through ``sf api request rest`` and parse its JSON response."""
    command = ["sf", "api", "request", "rest", path, "--method", method]
    org = os.environ.get("SF_TARGET_ORG")
    if org:
        command += ["--target-org", org]
    temporary = None
    try:
        if body is not None:
            descriptor, temporary = tempfile.mkstemp(suffix=".json")
            with os.fdopen(descriptor, "w", encoding="utf-8") as output:
                json.dump(body, output)
            command += ["--body", f"@{temporary}"]
        environment = dict(os.environ, SF_SKIP_NEW_VERSION_CHECK="true")
        try:
            process = subprocess.run(command, capture_output=True, text=True, timeout=120, env=environment)
        except FileNotFoundError:
            raise ToolError("the Salesforce CLI (sf) is not on PATH")
        except subprocess.TimeoutExpired:
            raise ToolError("Salesforce call timed out after 120s")
    finally:
        if temporary and os.path.exists(temporary):
            os.remove(temporary)
    output = process.stdout
    starts = [index for index in (output.find("{"), output.find("[")) if index != -1]
    if not starts:
        detail = (process.stderr or output).strip()[:500]
        raise ToolError(f"no JSON from sf (exit {process.returncode}): {detail}")
    try:
        return unescape(json.loads(output[min(starts):]))
    except json.JSONDecodeError as error:
        raise ToolError(f"unparseable response from sf: {error}")


def parse_params(args):
    params = args.get("queryParams") or {}
    if isinstance(params, str):
        try:
            params = json.loads(params)
        except json.JSONDecodeError:
            raise ToolError("queryParams must be an object")
    if not isinstance(params, dict):
        raise ToolError("queryParams must be an object")
    return params


def call_tool(name, args):
    """Execute one explicitly allowlisted read and return ``(text, is_error)``."""
    if name != "dispatch_readonly":
        raise ToolError(f"unknown tool {name!r}")
    if str(args.get("method", "")).upper() != "GET":
        raise ToolError("rejected: dispatch_readonly accepts only method GET")
    url = str(args.get("url", "")).strip()
    params = parse_params(args)

    layout = LAYOUT_URL_RE.fullmatch(url)
    if layout:
        if params != LAYOUT_PARAMS:
            raise ToolError("rejected: Opportunity layout reads require exactly layoutTypes=Full and modes=View")
        result = sf_rest(f"{url}?layoutTypes=Full&modes=View", "GET")
        return json.dumps(result, ensure_ascii=False, separators=(",", ":")), isinstance(result, list)

    match = QUERY_URL_RE.fullmatch(url)
    if not match:
        raise ToolError(
            "rejected: supported urls are GraphQL, SOQL query, and the v63.0 Opportunity Full/View layout read"
        )
    version, endpoint = match.groups()
    if endpoint == "graphql":
        raw = params.get("queryInput")
        try:
            body = json.loads(raw) if isinstance(raw, str) else raw
        except json.JSONDecodeError as error:
            raise ToolError(f"queryInput is not valid JSON: {error}")
        query = (body or {}).get("query") if isinstance(body, dict) else None
        if not isinstance(query, str) or not query.strip():
            raise ToolError('queryParams.queryInput must be a JSON string like {"query":"query { ... }"}')
        if not graphql_is_read(query):
            raise ToolError("rejected: only GraphQL queries are allowed (no mutation or subscription)")
        payload = {key: value for key, value in body.items() if key in ("query", "variables", "operationName")}
        result = sf_rest(f"/services/data/v{version}/graphql", "POST", payload)
        is_error = isinstance(result, list) or bool(isinstance(result, dict) and result.get("errors"))
        return json.dumps(result, ensure_ascii=False, separators=(",", ":")), is_error

    soql = params.get("q")
    if not isinstance(soql, str) or not re.match(r"\s*select\b", soql, re.IGNORECASE):
        raise ToolError("rejected: queryParams.q must be a SOQL SELECT statement")
    result = sf_rest(f"/services/data/v{version}/query?q={urllib.parse.quote(soql.strip())}", "GET")
    return json.dumps(result, ensure_ascii=False, separators=(",", ":")), isinstance(result, list)


def handle(message):
    """Return a JSON-RPC response dict, or ``None`` for notifications."""
    method, message_id = message.get("method"), message.get("id")
    if message_id is None:
        return None
    if method == "initialize":
        requested = (message.get("params") or {}).get("protocolVersion")
        version = requested if requested in PROTOCOL_VERSIONS else PROTOCOL_VERSIONS[0]
        result = {"protocolVersion": version, "capabilities": {"tools": {"listChanged": False}}, "serverInfo": SERVER_INFO}
    elif method == "ping":
        result = {}
    elif method == "tools/list":
        result = {"tools": TOOLS}
    elif method == "tools/call":
        params = message.get("params") or {}
        try:
            text, is_error = call_tool(params.get("name"), params.get("arguments") or {})
        except ToolError as error:
            text, is_error = f"error: {error}", True
        result = {"content": [{"type": "text", "text": text}], "isError": is_error}
    else:
        return {"jsonrpc": "2.0", "id": message_id, "error": {"code": -32601, "message": f"method not found: {method}"}}
    return {"jsonrpc": "2.0", "id": message_id, "result": result}


def send(obj):
    sys.stdout.write(json.dumps(obj, ensure_ascii=False) + "\n")
    sys.stdout.flush()


def main():
    log(f"started (org: {os.environ.get('SF_TARGET_ORG') or 'sf default'})")
    for line in sys.stdin:
        line = line.strip()
        if not line:
            continue
        try:
            message = json.loads(line)
        except json.JSONDecodeError:
            send({"jsonrpc": "2.0", "id": None, "error": {"code": -32700, "message": "parse error"}})
            continue
        if not isinstance(message, dict):
            send({"jsonrpc": "2.0", "id": None, "error": {"code": -32600, "message": "invalid request"}})
            continue
        response = handle(message)
        if response is not None:
            send(response)


if __name__ == "__main__":
    main()
